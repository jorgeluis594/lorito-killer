// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitType {
  UNIT
  KG
}

enum ProductType {
  SINGLE_PRODUCT
  PACKAGE_PRODUCT
  SERVICE_PRODUCT
  DISH
}

enum KitchenStatus {
  ACTIVE
  INACTIVE
}

enum PreparationStation {
  KITCHEN
  BAR
}

enum PrinterStatus {
  ACTIVE
  INACTIVE
}

enum PrinterPaperWidth {
  MM58
  MM80
}

model Product {
  id                         String                   @id @default(uuid())
  companyId                  String?
  company                    Company?                 @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name                       String
  preparationStation         PreparationStation?
  price                      Decimal
  sku                        String?
  stock                      Decimal?
  unitType                   UnitType?
  purchasePrice              Decimal?
  targetMovementProductId    String?
  targetMovementProductStock Decimal?
  description                String
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  productType                ProductType              @default(SINGLE_PRODUCT)
  kitchenId                  String?
  kitchen                    Kitchen?                 @relation(fields: [kitchenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hidden                     Boolean                  @default(false)
  searchVector               Unsupported("tsvector")?
  photos                     Photo[]
  childPackageItems          PackageItem[]            @relation("ChildProducts")
  parentPackageItems         PackageItem[]            @relation("ParentProducts")
  stockTransfers             StockTransfer[]
  categories                 Category[]
  orderItems                 OrderItem[]

  @@index([productType])
  @@index([kitchenId])
}

model PackageItem {
  id              String   @id @default(uuid())
  quantity        Int
  childProductId  String
  parentProductId String
  childProduct    Product  @relation("ChildProducts", fields: [childProductId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  parentProduct   Product  @relation("ParentProducts", fields: [parentProductId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Photo {
  id        String   @id @default(uuid())
  url       String
  name      String
  key       String
  type      String
  size      Int
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(uuid())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum UserRole {
  ADMIN
  CASHIER
  SELLER
  WAITER
  KITCHEN
  BARTENDER
}

enum StockTransferType {
  ORDER
  ADJUSTMENT
  PRODUCT_MOVEMENT
}

enum StockTransferStatus {
  PENDING
  EXECUTED
  ROLLED_BACK
  CANCELLED
}

model StockTransfer {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  status    StockTransferStatus @default(PENDING)
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  type      StockTransferType
  data      Json
  value     Decimal
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Expense {
  id          String    @id @default(uuid())
  cashShiftId String
  cashShift   CashShift @relation(fields: [cashShiftId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  amount      Decimal
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CashShift {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  companyId     String?
  company       Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  initialAmount Decimal
  finalAmount   Decimal?
  orders        Order[]
  payments      Payment[]
  status        ShiftStatus
  openedAt      DateTime
  closedAt      DateTime?
  expenses      Expense[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id                 String                 @id @default(uuid())
  quantity           Decimal
  discountAmount     Decimal
  discountType       DiscountType?
  discountValue      Decimal?
  netTotal           Decimal
  total              Decimal
  productId          String
  orderId            String
  productPrice       Decimal
  notes              String?
  preparationStation PreparationStation?
  round              Int                    @default(1)
  kitchenStatus      OrderItemKitchenStatus @default(PENDING)
  kitchenTakenAt     DateTime?
  kitchenTakenById   String?
  kitchenReadyAt     DateTime?
  kitchenReadyById   String?
  servedAt           DateTime?
  servedById         String?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledById      String?
  product            Product                @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderRoundItem     OrderRoundItem?
  kitchenTakenBy     User?                  @relation("KitchenTakenOrderItems", fields: [kitchenTakenById], references: [id], onDelete: SetNull)
  kitchenReadyBy     User?                  @relation("KitchenReadyOrderItems", fields: [kitchenReadyById], references: [id], onDelete: SetNull)
  servedBy           User?                  @relation("ServedOrderItems", fields: [servedById], references: [id], onDelete: SetNull)
  cancelledBy        User?                  @relation("CancelledOrderItems", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([kitchenStatus])
  @@index([orderId, productId])
}

enum OrderItemKitchenStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum DiscountType {
  AMOUNT
  PERCENT
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum OrderPaymentStatus {
  PENDING
  PAID
}

enum TableSessionStatus {
  OPEN
  BILL_REQUESTED
  CLOSED
  CANCELLED
}

enum OrderType {
  RETAIL
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum DeliveryStatus {
  PENDING
  DISPATCHED
  DELIVERED
}

model Order {
  id                 String             @id @default(uuid())
  cashShiftId        String?
  companyId          String?
  customerId         String?
  sellerId           String?
  customer           Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  company            Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  seller             User?              @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  discountAmount     Decimal
  discountType       DiscountType?
  discountValue      Decimal?
  netTotal           Decimal
  total              Decimal
  status             OrderStatus
  paymentStatus      OrderPaymentStatus @default(PENDING)
  cancellationReason String?
  orderType          OrderType          @default(RETAIL)
  tableSessionId     String?            @unique
  tableSession       TableSession?      @relation(fields: [tableSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cashShift          CashShift?         @relation(fields: [cashShiftId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  payments           Payment[]
  documents          Document[]
  documentType       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  orderItems         OrderItem[]
  rounds             OrderRound[]
  delivery           Delivery?

  @@index([companyId, sellerId])
  @@index([companyId, orderType, createdAt])
}

model Delivery {
  orderId        String         @id
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status         DeliveryStatus @default(PENDING)
  createdById    String
  createdBy      User           @relation("DeliveryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dispatchedAt   DateTime?
  dispatchedById String?
  dispatchedBy   User?          @relation("DeliveryDispatchedBy", fields: [dispatchedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveredAt    DateTime?
  deliveredById  String?
  deliveredBy    User?          @relation("DeliveryDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum DocumentType {
  INVOICE
  RECEIPT
  TICKET
}

enum DocumentStatus {
  REGISTERED
  CANCELLED
  PENDING_CANCELLATION
}

enum DocumentTaxDispatchStatus {
  PENDING
  ENQUEUED
  FAILED
}

model Document {
  id                 String               @id @default(uuid())
  orderId            String
  customerId         String?
  companyId          String?
  discountAmount     Decimal              @default(0)
  netTotal           Decimal
  total              Decimal
  documentType       DocumentType
  series             String
  number             Int
  dateOfIssue        DateTime
  qr                 String?
  hash               String?
  xml                String?
  status             DocumentStatus
  cancellationReason String?
  issuedToTaxEntity  Boolean              @default(false)
  issuedAt           DateTime?
  order              Order                @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  company            Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer           Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  taxDispatch        DocumentTaxDispatch?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model DocumentTaxDispatch {
  id         String                    @id @default(uuid())
  documentId String                    @unique
  companyId  String
  status     DocumentTaxDispatchStatus @default(PENDING)
  attempts   Int                       @default(0)
  jobId      String?
  lastError  String?
  enqueuedAt DateTime?
  document   Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  company    Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([companyId])
}

enum CustomerDocumentType {
  RUC
  DNI
  CARNET_EXTRANJERIA
}

model Customer {
  id             String                @id @default(uuid())
  companyId      String
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  documentType   CustomerDocumentType?
  documentNumber String?
  legalName      String?
  address        String?
  email          String?
  phoneNumber    String?
  geoCode        String?
  documents      Document[]
  orders         Order[]
}

model Company {
  id                     String                  @id @default(uuid())
  name                   String?
  subName                String?
  department             String?
  district               String?
  provincial             String?
  email                  String?
  phone                  String?
  address                String
  ruc                    String?
  customers              Customer[]
  users                  User[]
  products               Product[]
  cashShifts             CashShift[]
  orders                 Order[]
  categories             Category[]
  logos                  Logo[]
  stockTransfers         StockTransfer[]
  documents              Document[]
  documentTaxDispatches  DocumentTaxDispatch[]
  zones                  Zone[]
  tables                 Table[]
  tableSessions          TableSession[]
  features               CompanyFeature[]
  printClientLinkCodes   PrintClientLinkCode[]
  printClients           PrintClient[]
  printers               Printer[]
  kitchens               Kitchen[]
  kitchenTicketPrintJobs KitchetTicketPrintJob[]
  subdomain              String?                 @unique
  billingCredentials     Json?
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model CompanyFeature {
  id        String   @id @default(uuid())
  companyId String
  key       String
  enabled   Boolean
  config    Json?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
}

model Logo {
  id        String   @id @default(uuid())
  url       String
  name      String
  key       String
  type      String
  size      Int
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
}

model User {
  id                     String                  @id @default(uuid())
  companyId              String?
  company                Company?                @relation(fields: [companyId], references: [id])
  email                  String                  @unique
  password               String
  name                   String?
  role                   UserRole                @default(ADMIN)
  active                 Boolean                 @default(true)
  sellerCode             String?
  pin                    String?
  cashShifts             CashShift[]
  stockTransfers         StockTransfer[]
  waiterSessions         TableSession[]          @relation("WaiterSessions")
  soldOrders             Order[]                 @relation("SellerOrders")
  kitchenTakenOrderItems OrderItem[]             @relation("KitchenTakenOrderItems")
  kitchenReadyOrderItems OrderItem[]             @relation("KitchenReadyOrderItems")
  servedOrderItems       OrderItem[]             @relation("ServedOrderItems")
  cancelledOrderItems    OrderItem[]             @relation("CancelledOrderItems")
  printClientLinkCodes   PrintClientLinkCode[]
  orderRounds            OrderRound[]            @relation("OrderRoundResponsible")
  kitchenTicketPrintJobs KitchetTicketPrintJob[] @relation("KitchenTicketPrintRequester")
  orderItemCancellations OrderItemCancellation[]
  deliveriesCreated      Delivery[]              @relation("DeliveryCreatedBy")
  deliveriesDispatched   Delivery[]              @relation("DeliveryDispatchedBy")
  deliveriesDelivered    Delivery[]              @relation("DeliveryDeliveredBy")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([companyId, sellerCode])
  @@index([companyId, role])
  @@index([companyId, active])
}

model PrintClientLinkCode {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  codeHash    String   @unique
  expiresAt   DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@index([companyId])
}

model PrintClient {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  machineName     String
  credentialHash  String    @unique
  revokedAt       DateTime?
  lastSeenAt      DateTime
  lastInventoryAt DateTime?
  printers        Printer[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
}

model Printer {
  id                     String                  @id @default(uuid())
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  printClientId          String
  printClient            PrintClient             @relation(fields: [printClientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  localName              String
  status                 PrinterStatus           @default(ACTIVE)
  lastDetectedAt         DateTime
  paperWidth             PrinterPaperWidth       @default(MM58)
  columns                Int                     @default(32)
  codepageMapping        String                  @default("epson")
  cutEnabled             Boolean                 @default(true)
  feedBeforeCut          Int                     @default(3)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  kitchen                Kitchen?
  kitchenTicketPrintJobs KitchetTicketPrintJob[]

  @@unique([printClientId, localName])
  @@index([companyId])
}

model Kitchen {
  id              String           @id @default(uuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name            String
  status          KitchenStatus    @default(ACTIVE)
  printerId       String?          @unique
  printer         Printer?         @relation(fields: [printerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  products        Product[]
  orderRoundItems OrderRoundItem[]
  tickets         KitchenTicket[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([companyId])
}

model OrderRound {
  id                String           @id
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  number            Int
  responsibleUserId String
  responsibleUser   User             @relation("OrderRoundResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestHash       String
  tableSessionId    String?
  draftRevision     Int?
  items             OrderRoundItem[]
  kitchenTickets    KitchenTicket[]
  createdAt         DateTime         @default(now())

  @@unique([orderId, number])
  @@unique([tableSessionId, draftRevision])
  @@index([orderId, createdAt])
}

model OrderRoundItem {
  id            String                  @id @default(uuid())
  orderRoundId  String
  orderRound    OrderRound              @relation(fields: [orderRoundId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItemId   String                  @unique
  orderItem     OrderItem               @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productId     String
  productName   String
  quantity      Decimal
  notes         String?
  kitchenId     String?
  kitchen       Kitchen?                @relation(fields: [kitchenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cancellations OrderItemCancellation[]
  createdAt     DateTime                @default(now())

  @@index([orderRoundId, kitchenId])
}

model OrderItemCancellation {
  id               String         @id
  orderRoundItemId String
  orderRoundItem   OrderRoundItem @relation(fields: [orderRoundItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantity         Decimal
  reason           String?
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt        DateTime       @default(now())

  @@index([orderRoundItemId, createdAt])
}

model KitchenTicket {
  id           String                  @id @default(uuid())
  orderRoundId String
  orderRound   OrderRound              @relation(fields: [orderRoundId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  kitchenId    String
  kitchen      Kitchen                 @relation(fields: [kitchenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  printJobs    KitchetTicketPrintJob[]
  createdAt    DateTime                @default(now())

  @@unique([orderRoundId, kitchenId])
  @@index([kitchenId, createdAt])
}

enum KitchenTicketPrintJobStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model KitchetTicketPrintJob {
  id                  String                      @id @default(uuid())
  companyId           String
  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  kitchenTicketId     String
  kitchenTicket       KitchenTicket               @relation(fields: [kitchenTicketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  printerId           String
  printer             Printer                     @relation(fields: [printerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  content             Bytes
  isReprint           Boolean                     @default(false)
  requestedById       String
  requestedBy         User                        @relation("KitchenTicketPrintRequester", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status              KitchenTicketPrintJobStatus @default(PENDING)
  attempts            Int                         @default(0)
  nextAttemptAt       DateTime?
  claimRequestedAt    DateTime?
  processingStartedAt DateTime?
  lastError           String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([companyId, status, nextAttemptAt])
  @@index([status, nextAttemptAt])
  @@index([status, claimRequestedAt])
  @@index([status, processingStartedAt])
  @@index([kitchenTicketId, createdAt])
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  WALLET
}

model Payment {
  id          String        @id @default(uuid())
  cashShiftId String
  amount      Decimal
  orderId     String
  data        Json?
  method      PaymentMethod
  cashShift   CashShift     @relation(fields: [cashShiftId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum LocalityLevel {
  COUNTRY
  DEPARTMENT
  PROVINCE
  DISTRICT
}

model Locality {
  id          String        @id @default(uuid())
  idUbigeo    String        @unique
  name        String
  code        String
  tag         String
  searchValue String
  level       LocalityLevel
  parentId    String?
  children    Locality[]    @relation("LocalityParent")
  parent      Locality?     @relation("LocalityParent", fields: [parentId], references: [idUbigeo])

  @@index([name, code, tag, parentId])
}

model Zone {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  tables    Table[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Table {
  id        String         @id @default(uuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  number    Int
  label     String?
  capacity  Int            @default(4)
  zoneId    String
  zone      Zone           @relation(fields: [zoneId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  active    Boolean        @default(true)
  sessions  TableSession[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([companyId])
  @@index([companyId, zoneId])
}

model TableSession {
  id                 String             @id @default(uuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tableId            String
  table              Table              @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  waiterId           String
  waiter             User               @relation("WaiterSessions", fields: [waiterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  draft              Json               @default("[]")
  draftRevision      Int                @default(0)
  status             TableSessionStatus @default(OPEN)
  current            Boolean?           @default(true)
  guestCount         Int?
  notes              String?
  order              Order?
  openedAt           DateTime           @default(now())
  closedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  cancellationReason String?

  @@unique([tableId, current])
  @@index([companyId, status])
  @@index([tableId, status])
}
