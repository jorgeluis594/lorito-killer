      "html": "<button class=\"ds-primary\">Guardar cambios</button>",
      "css": ".ds-primary{min-height:44px;border-radius:var(--radius,8px);border:1px solid transparent;padding:10px 18px;font:700 13px Manrope,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:background-color 140ms ease-out,color 140ms ease-out;background:var(--jade,#087f68);color:var(--surface,#ffffff);}.ds-primary:hover:not(:disabled){background:var(--jade-hover,#066551);}.ds-primary:focus-visible{outline:2px solid var(--jade,#087f68);outline-offset:4px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}.ds-primary:active:not(:disabled){background:var(--ink,#173b33)}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
